# Copy to .env next to docker-compose.yml and fill in the secrets:
#   cp .env.example .env
# Never commit .env.

# ── Required ──
# Random, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=

# ── Optional (defaults shown) ──
POSTGRES_DB=smartcity_ai
POSTGRES_USER=smartcity
# Host port Nginx listens on.
HTTP_PORT=80
# Comma-separated browser origins allowed to call the API (only used when ENVIRONMENT=production).
CORS_ORIGINS=http://localhost
JWT_EXPIRE_MINUTES=1440
# Uvicorn worker processes in the backend container. Events reach every worker through Redis.
WEB_CONCURRENCY=2
# ── Email (staff account approval) ──
# console = write emails to the backend log only (default); smtp = really send.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@your-city.gov
EMAIL_FROM_NAME=SmartCity AI
# Any SMTP provider. Examples:
#   Gmail:    SMTP_HOST=smtp.gmail.com     SMTP_PORT=587 SMTP_SECURITY=starttls SMTP_USERNAME=you@gmail.com SMTP_PASSWORD=<app password>
#   SendGrid: SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587 SMTP_SECURITY=starttls SMTP_USERNAME=apikey        SMTP_PASSWORD=<API key>
#   SES:      SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587 SMTP_SECURITY=starttls (SMTP credentials from SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Public address of the site, used for "Sign in" / "Review request" links in emails.
FRONTEND_URL=http://localhost

# Use fine-tuned weights from scripts/train_yolo.py: put the .pt in backend/app/ai/weights/ and set
# YOLO_WEIGHTS=/opt/models/custom/civic-yolov8.pt
# YOLO_WEIGHTS=

# ── Local development without Docker (backend/.env) ──
# DATABASE_URL=sqlite:///./smartcity_ai.db
# REDIS_URL=                      # unset = in-process WebSocket events (single worker)
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_SIZE_MB=10
# SPACY_MODEL=en_core_web_sm
# INFRASTRUCTURE_FILE=            # defaults to backend/app/ai/data/infrastructure.json
# AUTO_MIGRATE=true               # run Alembic migrations on startup
